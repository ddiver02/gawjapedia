# ===========================================
# 환경 변수 설정 가이드
# ===========================================
# 이 파일을 .env.local로 복사하고 실제 값을 입력하세요
# 명령어: cp .env.local.example .env.local
# 주의: .env.local 파일은 Git에 커밋하지 마세요!

# -------------------------------------------
# Google Sheets API 설정
# -------------------------------------------
# 1. Google Cloud Console에서 프로젝트 생성
# 2. Google Sheets API 활성화
# 3. 서비스 계정 생성 후 JSON 키 다운로드
# 4. 아래 값들을 JSON 키 파일에서 복사

# Google Sheets 스프레드시트 ID
# URL에서 확인: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# 서비스 계정 이메일 (JSON 키의 client_email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com

# 서비스 계정 Private Key (JSON 키의 private_key)
# 주의: 개행 문자(\n)를 그대로 유지해야 합니다
# 예: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="your_private_key_here"

# -------------------------------------------
# Supabase 설정
# -------------------------------------------
# 1. https://supabase.com에서 프로젝트 생성
# 2. Settings > API에서 아래 값 확인

# Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (공개 가능, 클라이언트용)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role Key (비공개, 서버용)
# 주의: 이 키는 모든 RLS 정책을 우회하므로 절대 클라이언트에 노출하지 마세요
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# -------------------------------------------
# Vercel 배포 설정 (선택사항)
# -------------------------------------------
# Vercel에 배포 시 자동으로 설정됩니다
# 로컬 개발 시에는 http://localhost:3000 사용
NEXT_PUBLIC_VERCEL_URL=

# -------------------------------------------
# 추가 환경 변수 (필요시)
# -------------------------------------------
# Node 환경 (development, production, test)
NODE_ENV=development

# 애플리케이션 URL (로컬 개발)
NEXT_PUBLIC_APP_URL=http://localhost:3000
